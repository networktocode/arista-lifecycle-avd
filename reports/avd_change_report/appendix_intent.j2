{#- Render JSON the way tojson(indent=2) would, but replace the value of any password, secret, key or token
    field with <redacted>. Recurses through nested dicts and lists; every scalar still goes through tojson. -#}
{% macro rjson(node, pad='') -%}
{%- set nl = '\n' %}{% set ind = pad ~ '  ' -%}
{%- if node is mapping -%}
{%- if not node -%}{{ '{}' }}{% else %}{{ '{' }}{% for k, v in node.items() %}{{ nl }}{{ ind }}{{ k | string | tojson }}: {% if 'password' in (k | string | lower) or 'secret' in (k | string | lower) or 'key' in (k | string | lower) or 'token' in (k | string | lower) %}"<redacted>"{% else %}{{ rjson(v, ind) }}{% endif %}{{ ',' if not loop.last }}{% endfor %}{{ nl }}{{ pad }}{{ '}' }}{% endif -%}
{%- elif node is string -%}
{{ node | tojson }}
{%- elif node is iterable -%}
{%- if not node -%}[]{% else %}[{% for item in node %}{{ nl }}{{ ind }}{{ rjson(item, ind) }}{{ ',' if not loop.last }}{% endfor %}{{ nl }}{{ pad }}]{% endif -%}
{%- else -%}
{{ node | tojson }}
{%- endif -%}
{%- endmacro %}
